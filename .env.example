FRESHSERVICE_API_KEY=your_api_key_here
FRESHSERVICE_DOMAIN=your_company.freshservice.com
EXPORTER_PORT=9192
SCRAPE_INTERVAL=300

# DORA
FRESHSERVICE_ENABLE_DORA=true
FRESHSERVICE_ENABLE_RELEASES=true
FRESHSERVICE_DORA_LOOKBACK_DAYS=30
FRESHSERVICE_MTTR_TICKET_TYPES=Incident
FRESHSERVICE_INCLUDE_STATS=true

# Optional workspace filter (0 = all workspaces)
# FRESHSERVICE_WORKSPACE_ID=0
