{
  "title": "Freshservice DORA",
  "description": "DORA metrics sourced from Freshservice incidents, changes, and releases via freshservice-exporter.",
  "tags": ["dora", "freshservice", "itsm", "prometheus"],
  "uid": "freshservice-dora",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "timezone": "browser",
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "MTTR",
      "description": "Mean time to restore for incidents resolved in the exporter lookback window.",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "refId": "A",
          "expr": "freshservice_dora_mttr_seconds",
          "legendFormat": "MTTR"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 14400 },
              { "color": "red", "value": 86400 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Deployment frequency / day",
      "description": "Completed plus failed releases per day in the lookback window.",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "refId": "A",
          "expr": "freshservice_dora_deployment_frequency_per_day",
          "legendFormat": "deployments/day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Change failure rate",
      "description": "Failed releases divided by completed plus failed releases.",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "refId": "A",
          "expr": "freshservice_dora_change_failure_rate",
          "legendFormat": "failure rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.2 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Lead time for changes",
      "description": "Average time from change creation to close in the lookback window.",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "refId": "A",
          "expr": "freshservice_dora_lead_time_seconds",
          "legendFormat": "lead time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "MTTR trend",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "refId": "A",
          "expr": "freshservice_dora_mttr_seconds",
          "legendFormat": "MTTR"
        },
        {
          "refId": "B",
          "expr": "freshservice_dora_first_response_seconds",
          "legendFormat": "first response"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Deployment outcomes",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "refId": "A",
          "expr": "freshservice_dora_deployments_total",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Releases by status",
      "gridPos": { "x": 0, "y": 13, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "refId": "A",
          "expr": "freshservice_dora_releases_by_status_total",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Closed changes by type",
      "gridPos": { "x": 8, "y": 13, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "refId": "A",
          "expr": "freshservice_dora_changes_closed_total",
          "legendFormat": "{{change_type}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Open incidents by priority",
      "gridPos": { "x": 16, "y": 13, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "refId": "A",
          "expr": "freshservice_dora_open_incidents_total",
          "legendFormat": "{{priority}}"
        }
      ]
    }
  ]
}
